@model ECM.Domain.Entities.Catalogo.Product

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container-fluid mt-4">
    <div class="alert alert-danger shadow-sm" role="alert">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> ¡Atención!</h4>
        <p>¿Estás completamente seguro de que deseas eliminar este producto? Esta acción no se puede deshacer.</p>
    </div>

    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Confirmación de Eliminación</h5>
        </div>
        <div class="card-body">
            <h4 class="card-title fw-bold">@Model.Name</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-3 text-muted">SKU</dt>
                <dd class="col-sm-9">@Model.SKU</dd>

                <dt class="col-sm-3 text-muted">Precio</dt>
                <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-3 text-muted">Stock</dt>
                <dd class="col-sm-9">@Model.StockQuantity</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4 border-top pt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash"></i> Sí, Eliminar Definitivamente
                </button>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>