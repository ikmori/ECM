@model ECM.Domain.Entities.Catalogo.Product

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-info-circle text-info"></i> Detalles del Producto</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning shadow-sm me-2">
                <i class="bi bi-pencil"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                Volver a la Lista
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h4 class="card-title text-primary fw-bold">@Model.Name</h4>
            <p class="text-muted small">SKU: @Model.SKU</p>
        </div>
        <div class="card-body">
            <dl class="row mt-3">
                <dt class="col-sm-3 text-muted">Descripción</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3 text-muted">Precio</dt>
                <dd class="col-sm-9 fw-bold fs-5 text-success">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-3 text-muted">Inventario (Stock)</dt>
                <dd class="col-sm-9">
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="badge bg-success">@Model.StockQuantity disponibles</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Agotado</span>
                    }
                </dd>

                <dt class="col-sm-3 text-muted">Estado</dt>
                <dd class="col-sm-9">
                    @(Model.IsActive ? Html.Raw("<span class='badge bg-primary'>Activo</span>") : Html.Raw("<span class='badge bg-secondary'>Inactivo</span>"))
                </dd>
                
                <dt class="col-sm-3 text-muted">ID de Categoría</dt>
                <dd class="col-sm-9">@Model.CategoryId</dd>
            </dl>
        </div>
    </div>
</div>