@model ECM.Web.Models.Ventas.CartViewModel

@{
    ViewData["Title"] = "Mi Carrito";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-cart3 text-info"></i> Mi Carrito de Compras</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left"></i> Seguir Comprando
        </a>
    </div>
    <hr />

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm">
            <i class="bi bi-cart-x fs-1 text-secondary mb-3 d-block"></i>
            <h4 class="text-muted fw-bold">Tu carrito está vacío.</h4>
            <p>¡Explora nuestro catálogo y agrega productos increíbles!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3 px-4 shadow-sm">Ir al Catálogo</a>
        </div>
    }
    else
    {
        <div class="row mb-5">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-3 border-0">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Producto</th>
                                    <th>Precio</th>
                                    <th style="width: 160px;">Cantidad</th>
                                    <th>Subtotal</th>
                                    <th class="text-center pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium text-dark">
                                            @item.ProductName 
                                            <br><small class="text-muted">ID: @item.ProductId</small>
                                        </td>
                                        <td>$@item.UnitPrice.ToString("N2")</td>
                                        <td>
                                            <form asp-controller="ShoppingCart" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <input type="number" name="newQuantity" value="@item.Quantity" class="form-control form-control-sm me-2 text-center shadow-sm" min="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary shadow-sm" title="Actualizar">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td class="fw-bold text-success">$@item.SubTotal.ToString("N2")</td>
                                        <td class="text-center pe-3">
                                            <form asp-controller="ShoppingCart" asp-action="RemoveItem" method="post">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm" title="Eliminar este producto">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <form asp-controller="ShoppingCart" asp-action="ClearCart" method="post" onsubmit="return confirm('¿Estás seguro de que deseas vaciar todo el carrito?');">
                        <button type="submit" class="btn btn-link text-danger text-decoration-none fw-semibold">
                            <i class="bi bi-trash3"></i> Vaciar Carrito
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-header bg-white border-bottom pt-4 pb-3">
                        <h5 class="card-title fw-bold mb-0 text-dark">Resumen del Pedido</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal (@Model.Items.Sum(i => i.Quantity) artículos)</span>
                            <span class="fw-medium">$@Model.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 border-bottom pb-3">
                            <span class="text-muted">Envío estimado</span>
                            <span class="text-muted fst-italic">Calculado en checkout</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fs-5 fw-bold text-dark">Total Estimado</span>
                            <span class="fs-4 fw-bold text-success">$@Model.TotalAmount.ToString("N2")</span>
                        </div>
                        
                        <form asp-controller="Order" asp-action="Create" method="post">
                            <input type="hidden" name="userId" value="1" />
                            <button type="submit" class="btn btn-success w-100 py-3 fw-bold fs-6 shadow-sm">
                                <i class="bi bi-credit-card me-2"></i> Proceder al Checkout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>