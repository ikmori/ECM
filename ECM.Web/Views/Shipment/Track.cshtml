@using ECM.Domain.Common.Enums
@model ECM.Web.Models.Logistica.TrackShipmentViewModel

@{
    ViewData["Title"] = "Rastrear Envío";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0 text-center">
                        <i class="bi bi-search"></i> Rastrear tu Envío
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Track">
                        <div class="input-group mb-3">
                            <input type="text" name="trackingNumber" class="form-control form-control-lg" 
                                   placeholder="Ingresa tu número de tracking" 
                                   value="@Model?.TrackingNumber" />
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search"></i> Rastrear
                            </button>
                        </div>
                    </form>

                    @if (Model?.Shipment != null)
                    {
                        <div class="mt-4">
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle"></i> Envío encontrado
                            </div>

                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Estado: 
                                        <span class="badge bg-@Model.Shipment.StatusBadgeClass">
                                            @Model.Shipment.Status
                                        </span>
                                    </h5>

                                    <div class="progress mb-3" style="height: 10px;">
                                        <div class="progress-bar bg-success" 
                                             role="progressbar" 
                                             style="width: @(Model.Shipment.Status == ShipmentStatus.Delivered ? "100%" : 
                                                           Model.Shipment.Status == ShipmentStatus.InTransit ? "75%" :
                                                           Model.Shipment.Status == ShipmentStatus.Shipped ? "50%" :
                                                           Model.Shipment.Status == ShipmentStatus.Preparing ? "25%" : "0%")">
                                        </div>
                                    </div>

                                    <dl class="row">
                                        <dt class="col-sm-4">Número de Tracking:</dt>
                                        <dd class="col-sm-8">@Model.Shipment.TrackingNumber</dd>

                                        <dt class="col-sm-4">Transportista:</dt>
                                        <dd class="col-sm-8">@Model.Shipment.CarrierName</dd>

                                        <dt class="col-sm-4">Fecha Estimada:</dt>
                                        <dd class="col-sm-8">
                                            @(Model.Shipment.EstimatedDeliveryDate?.ToString("dd/MM/yyyy") ?? "No especificada")
                                        </dd>

                                        @if (Model.Shipment.ActualDeliveryDate.HasValue)
                                        {
                                            <dt class="col-sm-4">Fecha de Entrega:</dt>
                                            <dd class="col-sm-8">
                                                <strong class="text-success">@Model.Shipment.ActualDeliveryDate.Value.ToString("dd/MM/yyyy")</strong>
                                            </dd>
                                        }
                                    </dl>
                                </div>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model?.TrackingNumber))
                    {
                        <div class="alert alert-danger mt-3">
                            <i class="bi bi-exclamation-triangle"></i>
                            No se encontró ningún envío con el número de tracking ingresado.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>