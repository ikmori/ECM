@model ECM.Domain.Entities.Ventas.Order

@{
    ViewData["Title"] = "Cancelar Orden";
}

<h1 class="text-danger">Cancelar Orden #@Model.Id</h1>

<h3>¿Estás seguro que deseas cancelar esta orden?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.OrderDate.ToString("g")</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirmar Cancelación" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>