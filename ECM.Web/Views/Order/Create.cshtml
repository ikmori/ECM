@model ECM.Web.Models.Ventas.OrderViewModel

@{
    ViewData["Title"] = "Crear Orden";
}

<h1>Crear Orden</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label class="control-label">ID de Usuario </label>
                <input name="userId" type="number" class="form-control" required />
                <small class="text-muted">esto es una demo en el flujo real esto vendría de la sesión o el token del usuario logueado.</small>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Generar Orden" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Volver a la lista</a>
</div>