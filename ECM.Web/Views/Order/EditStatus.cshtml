@using ECM.Domain.Common.Enums
@model ECM.Domain.Entities.Ventas.Order

@{
    ViewData["Title"] = "Cambiar Estado";
}

<h1>Cambiar Estado de Orden #@Model.Id</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditStatus">
            <input type="hidden" name="id" value="@Model.Id" />
            
            <div class="form-group mb-3">
                <label class="control-label">Estado Actual: <strong>@Model.Status</strong></label>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Nuevo Estado</label>
                <select name="newStatus" class="form-control" asp-items="Html.GetEnumSelectList<OrderStatus>()"></select>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Actualizar" class="btn btn-warning" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Volver a la lista</a>
</div>