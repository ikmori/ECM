@model ECM.Web.Models.Ventas.OrderViewModel

@{
    ViewData["Title"] = "Detalles de la Orden";
}

<h1>Detalles de la Orden #@Model.Id</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.OrderDate.ToLocalTime().ToString("g")</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Dirección de Envío</dt>
        <dd class="col-sm-10">@Model.ShippingAddress</dd>

        <dt class="col-sm-2">SubTotal</dt>
        <dd class="col-sm-10">@Model.SubTotal.ToString("C")</dd>

        <dt class="col-sm-2">Total Final</dt>
        <dd class="col-sm-10 fw-bold">@Model.TotalAmount.ToString("C")</dd>
    </dl>
</div>

<hr />
<h4>Agregar Producto a la Orden (Demo)</h4>
<div class="card mb-4 bg-light">
    <div class="card-body">
        <form asp-action="AddItem" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="orderId" value="@Model.Id" />
            
            <div class="col-md-2">
                <label class="form-label text-muted">ID Prod.</label>
                <input type="number" name="productId" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted">Nombre del Producto</label>
                <input type="text" name="productName" class="form-control form-control-sm" placeholder="Ej: Laptop Asus" required />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted">Cant.</label>
                <input type="number" name="quantity" class="form-control form-control-sm" value="1" min="1" required />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted">Precio Unit.</label>
                <input type="number" name="unitPrice" class="form-control form-control-sm" step="0.01" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success btn-sm w-100">+ Agregar</button>
            </div>
        </form>
    </div>
</div>

<h4>Artículos en esta Orden (@Model.OrderItems.Count)</h4>
@if (Model.OrderItems.Any())
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio Unitario</th>
                <th>Subtotal Item</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">Aún no hay productos en esta orden.</div>
}
<div>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>