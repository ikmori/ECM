@using ECM.Domain.Common.Enums
@model ECM.Web.Models.Logistica.CouponViewModel

@{
    ViewData["Title"] = $"Detalles - {Model.Code}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-ticket-perforated"></i> Detalles del Cupón
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Código:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-primary fs-6">@Model.Code</span>
                                </dd>

                                <dt class="col-sm-4">Tipo:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Type == DiscountType.Percentage)
                                    {
                                        <span class="badge bg-info">Porcentaje</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Monto Fijo</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Valor:</dt>
                                <dd class="col-sm-8 fw-bold">@Model.FormattedValue</dd>

                                <dt class="col-sm-4">Monto Mínimo:</dt>
                                <dd class="col-sm-8">@Model.FormattedMinimumAmount</dd>

                                <dt class="col-sm-4">Usos Máximos:</dt>
                                <dd class="col-sm-8">@Model.MaxUsage</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">Usos Actuales:</dt>
                                <dd class="col-sm-7">@Model.TimesUsed</dd>

                                <dt class="col-sm-5">Fecha de Creación:</dt>
                                <dd class="col-sm-7">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-5">Fecha de Expiración:</dt>
                                <dd class="col-sm-7">@Model.ExpirationDate.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-5">Estado:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.StatusText == "Activo")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i> Inactivo
                                        </span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Progreso:</dt>
                                <dd class="col-sm-7">
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar @(Model.UsagePercentage >= 100 ? "bg-danger" : "bg-success")" 
                                             role="progressbar" 
                                             style="width: @Model.UsagePercentage%">
                                            @Model.UsagePercentage%
                                        </div>
                                    </div>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>