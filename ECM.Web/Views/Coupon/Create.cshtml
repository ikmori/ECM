@using ECM.Domain.Common.Enums
@model ECM.Web.Models.Logistica.CreateCouponViewModel

@{
    ViewData["Title"] = "Crear Cupón";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle"></i> Crear Nuevo Cupón
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                <input asp-for="Code" class="form-control" placeholder="Ej: DESCUENTO20" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Code" class="text-danger"></span>
                            <small class="form-text text-muted">El código se guardará en mayúsculas automáticamente.</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Type" class="form-label fw-bold"></label>
                                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<DiscountType>()">
                                    <option value="">Seleccione...</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Value" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text" id="valueSymbol">%</span>
                                    <input asp-for="Value" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Value" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinimumOrderAmount" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="MinimumOrderAmount" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="MinimumOrderAmount" class="text-danger"></span>
                                <small class="form-text text-muted">Opcional. Dejar vacío para sin mínimo.</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxUsage" class="form-label fw-bold"></label>
                                <input asp-for="MaxUsage" class="form-control" type="number" min="1" />
                                <span asp-validation-for="MaxUsage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpirationDate" class="form-label fw-bold"></label>
                            <input asp-for="ExpirationDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Crear Cupón
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Cambiar el símbolo según el tipo de descuento
        document.getElementById('Type').addEventListener('change', function() {
            const valueSymbol = document.getElementById('valueSymbol');
            if (this.value === 'Percentage') {
                valueSymbol.textContent = '%';
            } else if (this.value === 'FixedAmount') {
                valueSymbol.textContent = '$';
            } else {
                valueSymbol.textContent = '%';
            }
        });
    </script>
}