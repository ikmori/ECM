@model ECM.Web.Models.Logistica.UserReviewsViewModel

@{
    ViewData["Title"] = $"Mis Reseñas - {Model.UserName}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-star text-warning"></i> 
            Mis Reseñas
        </h1>
        <div class="text-muted">
            Total: @Model.TotalReviews reseñas
        </div>
    </div>

    @if (!Model.Reviews.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No has escrito ninguna reseña aún</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-shop"></i> Explorar productos
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var review in Model.Reviews)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h5 class="card-title">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@review.ProductId" class="text-decoration-none">
                                    @review.ProductName
                                </a>
                            </h5>
                            <div class="mb-2">
                                @Html.Raw(review.StarRatingHtml)
                                <span class="ms-2 text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <p class="card-text">@review.Comment</p>
                            }
                        </div>
                        <div class="btn-group btn-group-sm ms-3">
                            <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-outline-warning" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-outline-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>