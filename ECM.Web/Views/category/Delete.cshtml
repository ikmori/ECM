@model ECM.Domain.Entities.Catalogo.Category

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="mb-4">
                <i class="bi bi-exclamation-octagon text-danger display-1"></i>
                <h2 class="fw-bold mt-2">¿Confirmar eliminación?</h2>
                <p class="text-muted">Estás a punto de eliminar permanentemente la categoría:</p>
                <h4 class="text-dark fw-bold">"@Model.Name"</h4>
            </div>

            <div class="card shadow-sm border-danger mb-4">
                <div class="card-body">
                    <p class="card-text">@Model.Description</p>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-danger btn-lg px-5">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>