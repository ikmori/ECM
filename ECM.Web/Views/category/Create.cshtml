@model ECM.Domain.Entities.Catalogo.Category
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold"><i class="bi bi-plus-circle me-2 text-primary"></i>Nueva Categoría</h2>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Nombre</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej: Electrónica" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Descripción</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Opcional..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="activeSwitch" checked>
                            <label class="form-check-label fw-bold" for="activeSwitch">Categoría Activa</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Guardar Categoría
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}